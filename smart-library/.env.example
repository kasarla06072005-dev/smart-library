# Copy to .env (same folder as docker-compose.yml) and fill in real values
# before running `docker compose up`. Never commit the real .env file.

DB_PASSWORD=choose-a-strong-database-password

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters

ADMIN_EMAIL=admin@yourlibrary.com
ADMIN_PASSWORD=choose-a-strong-admin-password

# The URL people will use to reach the frontend, e.g. https://library.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:5173

# The URL the frontend should call for the API, e.g. https://api.yourdomain.com
VITE_API_BASE_URL=http://localhost:8080
